[Definition]
# Apache auth_form emits AH01807 for a bad password and AH01808 for an
# unknown user. Restrict matches to the Feutsolver login handler so unrelated
# authentication failures on the same virtual host cannot trigger this jail.
failregex = ^.*\[auth_form:error\].*\[client <HOST>(?::[0-9]+)?\]\s+AH0180[78]:.*/feutsolver-login-submit.*$
ignoreregex =
