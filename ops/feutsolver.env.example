# Explicit production posture. Keep the real file outside Git and load it from
# feutsolver.service with EnvironmentFile=.
APP_ENV=production
APP_ALLOW_LOCAL_WORDLIST_MUTATIONS=0
FEUTSOLVER_MAX_OCR_WORKERS=2
FEUTSOLVER_MAX_SOLVER_WORKERS=2
FEUTSOLVER_RUNTIME_CACHE_WRITE=0
WORDFEUD_OCR_BACKEND=local
